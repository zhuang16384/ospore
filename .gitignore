# Dependencies
node_modules/
.pnpm-debug-log*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build outputs: electron-vite, electron-builder, and Playwright all write under one
# directory so editors only need to hide a single path
/build-output/

# Fallbacks if a tool ever runs with default paths (electron-builder defaults to dist/)
dist/
release/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
*.lcov

# Playwright's default report/results dirs. The config redirects both into
# build-output/, but keep them so a run with default paths cannot dirty the tree
playwright-report/
test-results/

# Playwright and vitest browser mode both write failure screenshots here
__screenshots__/
.vitest-attachments/

# Local test database (OSPORE_DATA_DIR target for manual testing)
/.test-data/

# Transient config bundles from vite/vitest; linger in the root if a run is killed
*.timestamp-*.mjs

# Tool caches
.eslintcache
.vite/
.electron-builder/
.electron-vite/

# Env files
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.sw?

# OS files
.DS_Store
._*
[Tt]humbs.db
desktop.ini

# Security
*.pem
*.key
*.csr
*.crt
*.p12
*.pfx

# Project documentation & runtime logs (kept local, not tracked)
/docs/
